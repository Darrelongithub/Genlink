# /etc/adapt/web.env -- root:adapt 0640
# No Gemini, YouTube, database, session or encryption credentials belong here.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
ADAPT_API=http://127.0.0.1:8000
# Exact public DNS name(s), comma-separated; no scheme, port or wildcard.
# This check is required here because the API proxy intentionally rewrites Host.
ADAPT_ALLOWED_HOSTS=learn.example.com
# Nginx is the direct peer. Forwarding headers from anyone else are ignored.
ADAPT_TRUSTED_PROXIES=127.0.0.1,::1
ADAPT_MAX_BODY_BYTES=8388608
ADAPT_PROXY_TIMEOUT_MS=120000
ADAPT_SHUTDOWN_TIMEOUT_MS=5000
NEXT_TELEMETRY_DISABLED=1
