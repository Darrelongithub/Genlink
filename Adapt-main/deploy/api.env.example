# /etc/adapt/api.env -- root:adapt 0640
# Replace learn.example.com before starting. Never put this file in the web service.
ADAPT_MODE=production
ADAPT_DEBUG=false
ADAPT_DEMO_MODE=false
ADAPT_SEED_DEMO_STUDENTS=false
ADAPT_FRONTEND_ORIGIN=https://learn.example.com
ADAPT_EXTRA_ALLOWED_HOSTS=learn.example.com
ADAPT_ALLOWED_ORIGINS=
ADAPT_REQUIRE_HTTPS=true
# Node is the only direct API peer in the documented single-host topology.
ADAPT_TRUSTED_PROXIES=127.0.0.1,::1

ADAPT_DATA_DIR=/var/lib/adapt
ADAPT_DB_PATH=/var/lib/adapt/adapt.db
ADAPT_KEYFILE=/var/lib/adapt/keys/adapt.key
# Strict SQLCipher fails instead of silently writing a plaintext container.
# The lock installs the driver on Linux x86_64/aarch64. See the runbook for other architectures.
ADAPT_DB_ENCRYPTION=sqlcipher
ADAPT_ENFORCE_FIELD_ENCRYPTION=true

ADAPT_LOG_LEVEL=INFO
ADAPT_REQUEST_LOG_ENABLED=true
ADAPT_MAX_BODY_BYTES=8388608
ADAPT_MAX_CONCURRENT_REQUESTS=100
ADAPT_GRACEFUL_SHUTDOWN_TIMEOUT_S=30
ADAPT_KEEPALIVE_TIMEOUT_S=5
ADAPT_RATE_LIMIT_MULTIPLIER=1
ADAPT_ALLOW_LOCAL_FALLBACK=true

# Optional credit-plan configuration. The packaged default is illustrative and unpriced.
# ADAPT_CREDIT_PLANS_PATH=/etc/adapt/credit_plans.json

# Optional provider configuration. Keep real values out of source, shell history and web.env.
# ADAPT_GEMINI_API_KEY=
# ADAPT_GEMINI_MODEL_LIGHT=gemini-flash-lite-latest
# ADAPT_GEMINI_MODEL_STANDARD=gemini-flash-latest
# ADAPT_GEMINI_MODEL_DEEP=gemini-pro-latest
# ADAPT_GEMINI_DAILY_CALL_BUDGET=120
# ADAPT_GEMINI_DAILY_TOKEN_BUDGET=2000000
# ADAPT_GEMINI_TIMEOUT_S=45
# ADAPT_YOUTUBE_API_KEY=

# Direct TLS is an alternative to the documented Nginx + Node proxy, not an addition to it.
# Both paths must be set together; do not terminate TLS twice.
# ADAPT_TLS_CERTFILE=/etc/adapt/tls/fullchain.pem
# ADAPT_TLS_KEYFILE=/etc/adapt/tls/privkey.pem
