[Unit]
Description=Adapt Next.js custom server and API proxy
After=network-online.target adapt-api.service
Wants=network-online.target adapt-api.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=adapt
Group=adapt
WorkingDirectory=/opt/adapt/frontend
EnvironmentFile=/etc/adapt/web.env
ExecStart=/usr/bin/env node server.mjs
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

MemoryMax=1G
TasksMax=128
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adapt-web

[Install]
WantedBy=multi-user.target
