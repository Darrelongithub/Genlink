# Genlink browser configuration
# Copy this file to .env.local for local work. Vite only exposes VITE_* values.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key

# Optional: the Adapt web origin. Leave blank to use the same hostname on
# port 3000, which is what `npm run host` uses on a Fedora workstation.
# For a shared/tunnelled setup use the complete URL, for example:
# VITE_ADAPT_URL=https://adapt.example.test
VITE_ADAPT_URL=
# Adapt's local port defaults to 3000. This is useful if another service uses 3000.
# VITE_ADAPT_PORT=3000
# The lesson hand-off prompt defaults to 90 seconds of quiet time. Lower it for a demo walk-through.
# VITE_ADAPT_CHECKIN_DELAY_MS=90000

# Optional Genlink ports. Adapt's host port is configured separately in
# adapt/.env and defaults to 3000.
# VITE_PORT=8080
# VITE_PREVIEW_PORT=4173
