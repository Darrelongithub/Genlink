{
  "name": "adapt-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "node ../scripts/check-contract.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "demo": "node ../scripts/demo.mjs",
    "probe": "node scripts-ui-probe.mjs",
    "probe:mock": "node scripts-ui-probe.mjs --mock",
    "test:engine": "node --test src/lib/engine/*.test.mjs",
    "test:lib": "node --test src/lib/*.test.mjs",
    "test:server": "node --test server.test.mjs",
    "test:env": "node --test env.test.mjs",
    "test:e2e:banned": "node tests-e2e/banned-phrases.mjs",
    "test:e2e:demo": "node tests-e2e/demo-flow.mjs",
    "host": "npm run build && node host.mjs",
    "dev:web": "node server.mjs",
    "test:dev": "node --test dev.test.mjs",
    "test:e2e:round4": "node tests-e2e/round4.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
