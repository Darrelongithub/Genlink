# Frontend-only environment
# Copy this file to frontend/.env.local when using `npm run dev:web` or `npm run start`.
# The custom Node front door loads this file explicitly; it is not enough to merely
# create it and rely on Next to read it.

ADAPT_API=http://127.0.0.1:8000
HOST=0.0.0.0
PORT=3000
# Comma-separated Next dev origins. Do not put a provider key in this file.
ADAPT_DEV_ORIGIN=localhost,127.0.0.1

# Set this only when you deliberately want a separate build directory.
# ADAPT_NEXT_DIST=.next-build
# ADAPT_API=offline
